{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"title": "Spyglass Config",
	"description": "https://spyglassmc.com/user/config",
	"definitions": {
		"SummaryOverride": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string"
				},
				"replace": {
					"type": "boolean"
				}
			},
			"required": [ "path" ]
		},
		"NameLint": {
			"anyOf": [
				{
					"type": [ "string", "null" ]
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"default": [ "error", "VALUE" ]
				}
			]
		},
		"Patterns": {
			"type": [ "string", "array" ],
			"items": {
				"type": "string",
				"format": "regex"
			}
		},
		"Action": {
			"title": "Action",
			"type": "object",
			"oneOf": [ { "required": [ "declare" ] }, { "required": [ "report" ] } ],
			"properties": {
				"declare": {
					"enum": [ "block", "file", "public" ]
				},
				"report": {
					"enum": [ "inherit", "hint", "information", "warning", "error" ]
				}
			},
			"additionalProperties": false
		},
		"Severity": {
			"enum": [ "hint", "information", "warning", "error" ]
		},
		"BooleanLint": {
			"anyOf": [
				{
					"type": [ "boolean", "null" ]
				},
				{
					"$ref": "#/definitions/Severity"
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": [
						{ "$ref": "#/definitions/Severity" },
						{ "type": "boolean" }
					],
					"default": [ "warning", true ]
				}
			]
		},
		"ImpDocBooleanLint": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"enum": [ true ]
				},
				{
					"$ref": "#/definitions/Severity"
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": [
						{ "$ref": "#/definitions/Severity" },
						{ "enum": [ true ] }
					],
					"default": [ "warning", true ]
				}
			]
		},
		"QuoteConfig": {
			"title": "QuoteConfig",
			"type": "object",
			"properties": {
				"always": {
					"type": "boolean",
					"description": "Whether the string must be quoted (`true`) or must not be quoted (`false`). A value that cannot be written unquoted is always required to be quoted regardless of this setting."
				},
				"avoidEscape": {
					"type": [ "boolean", "null" ],
					"description": "When `true`, the other quotation mark is used instead of the preferred one if the value contains the preferred one. Equivalent to the legacy `prefer double` / `prefer single` quote types."
				},
				"type": {
					"enum": [ "double", "single" ],
					"description": "The preferred quotation mark. Omit to skip checking the quotation mark type."
				}
			},
			"additionalProperties": false
		},
		"QuoteLint": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"$ref": "#/definitions/QuoteConfig"
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": [
						{ "$ref": "#/definitions/Severity" },
						{ "$ref": "#/definitions/QuoteConfig" }
					],
					"default": [ "warning", { "always": true, "type": "double", "avoidEscape": true } ]
				}
			]
		},
		"SelectorSortKeysLint": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"type": "array",
					"items": { "type": "string" },
					"not": {
						"minItems": 1,
						"items": [ { "$ref": "#/definitions/Severity" } ]
					}
				},
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": [
						{ "$ref": "#/definitions/Severity" },
						{ "type": "array", "items": { "type": "string" } }
					]
				}
			]
		},
		"Complex": {
			"title": "Complex",
			"type": "object",
			"properties": {
				"if": {
					"type": [ "object", "array" ],
					"properties": {
						"category": {
							"$ref": "#/definitions/Patterns"
						},
						"pattern": {
							"$ref": "#/definitions/Patterns"
						},
						"excludePattern": {
							"$ref": "#/definitions/Patterns"
						},
						"namespace": {
							"$ref": "#/definitions/Patterns"
						},
						"excludeNamespace": {
							"$ref": "#/definitions/Patterns"
						}
					},
					"additionalProperties": false,
					"items": {
						"$ref": "#/definitions/Complex/properties/if"
					}
				},
				"then": {
					"$ref": "#/definitions/Action"
				},
				"override": {
					"anyOf": [
						{ "$ref": "#/definitions/Complex" },
						{ "type": "array", "items": { "$ref": "#/definitions/Complex" } }
					]
				}
			},
			"additionalProperties": false
		}
	},
	"properties": {
		"env": {
			"type": "object",
			"properties": {
				"dependencies": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"exclude": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"customResources": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"properties": {
							"category": {
								"type": "string"
							},
							"ext": {
								"type": "string",
								"pattern": "^\\.",
								"examples": [ ".json" ]
							},
							"pack": {
								"enum": [ "data", "assets" ]
							},
							"since": {
								"type": "string",
								"pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
							},
							"until": {
								"type": "string",
								"pattern": "^\\d+\\.\\d+(\\.\\d+)$"
							}
						},
						"additionalProperties": false,
						"required": [ "category" ]
					}
				},
				"feature": {
					"type": "object",
					"properties": {
						"codeActions": { "type": "boolean" },
						"colors": { "type": "boolean" },
						"completions": { "type": "boolean" },
						"documentHighlighting": { "type": "boolean" },
						"documentLinks": { "type": "boolean" },
						"foldingRanges": { "type": "boolean" },
						"formatting": { "type": "boolean" },
						"hover": { "type": "boolean" },
						"inlayHint": {
							"type": "object",
							"properties": {
								"enabledNodes": {
									"type": "array",
									"items": { "type": "string" }
								}
							},
							"additionalProperties": false
						},
						"semanticColoring": {
							"anyOf": [
								{
									"type": "object",
									"properties": {
										"disabledLanguages": {
											"type": "array",
											"items": { "type": "string" }
										}
									},
									"additionalProperties": false
								},
								{
									"type": "boolean"
								}
							]
						},
						"selectionRanges": { "type": "boolean" },
						"signatures": { "type": "boolean" }
					},
					"additionalProperties": false
				},
				"gameVersion": {
					"type": "string",
					"examples": [ "Auto", "Latest release", "Latest snapshot" ]
				},
				"permissionLevel": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4
				},
				"plugins": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"mcmetaSummaryOverrides": {
					"type": "object",
					"properties": {
						"blocks": {
							"$ref": "#/definitions/SummaryOverride"
						},
						"commands": {
							"$ref": "#/definitions/SummaryOverride"
						},
						"fluids": {
							"$ref": "#/definitions/SummaryOverride"
						},
						"registries": {
							"$ref": "#/definitions/SummaryOverride"
						}
					},
					"additionalProperties": false
				},
				"enableMcdocCaching": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"format": {
			"type": "object",
			"additionalProperties": {
				"title": "UNDOCUMENTED"
			}
		},
		"lint": {
			"type": "object",
			"properties": {
				"nameOfNbtKey": {
					"$ref": "#/definitions/NameLint"
				},
				"nameOfObjective": {
					"$ref": "#/definitions/NameLint"
				},
				"nameOfScoreHolder": {
					"$ref": "#/definitions/NameLint"
				},
				"nameOfTag": {
					"$ref": "#/definitions/NameLint"
				},
				"nameOfTeam": {
					"$ref": "#/definitions/NameLint"
				},
				"commandStringQuote": {
					"description": "Quotation style for `brigadier:string` command arguments that accept a quoted phrase.",
					"$ref": "#/definitions/QuoteLint"
				},
				"nbtKeyQuote": {
					"description": "Quotation style for NBT compound tag keys.",
					"$ref": "#/definitions/QuoteLint"
				},
				"nbtPathQuote": {
					"description": "Quotation style for NBT path keys.",
					"$ref": "#/definitions/QuoteLint"
				},
				"nbtStringQuote": {
					"description": "Quotation style for NBT string tag values.",
					"$ref": "#/definitions/QuoteLint"
				},
				"selectorKeyQuote": {
					"description": "Quotation style for entity selector argument keys.",
					"$ref": "#/definitions/QuoteLint"
				},
				"selectorSortKeys": {
					"description": "The order that entity selector argument keys should appear in. Keys absent from the list are ignored.",
					"$ref": "#/definitions/SelectorSortKeysLint"
				},
				"nbtBoolean": {
					"description": "When `true`, boolean-typed NBT values must be written as `true` / `false`. When `false`, they must be written as byte tags (`1b` / `0b`).",
					"$ref": "#/definitions/BooleanLint"
				},
				"impDocPrivate": {
					"description": "Report references that violate IMP-Doc `@private` / `@within` visibility. Fork-only rule.",
					"$ref": "#/definitions/ImpDocBooleanLint"
				},
				"impDocPrivateBestEffort": {
					"description": "Warning-level counterpart of `impDocPrivate` for references whose caller cannot be resolved exactly. Fork-only rule.",
					"$ref": "#/definitions/ImpDocBooleanLint"
				},
				"impDocVisibilityConflict": {
					"description": "Report symbols declared with conflicting IMP-Doc visibility in more than one place. Fork-only rule.",
					"$ref": "#/definitions/ImpDocBooleanLint"
				},
				"impDocContractCheck": {
					"description": "Semantic checks for typed IMP-Doc function contracts. Fork-only rule. Defaults to `off`.",
					"enum": [ "off", "information", "warning", "error" ]
				},
				"undeclaredSymbol": {
					"type": "array",
					"items": {
						"oneOf": [
							{ "$ref": "#/definitions/NameLint" },
							{ "$ref": "#/definitions/Action" },
							{ "$ref": "#/definitions/Complex" }
						]
					}
				}
			},
			"additionalProperties": {
				"title": "UNDOCUMENTED"
			}
		},
		"snippet": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		}
	},
	"additionalProperties": false
}
